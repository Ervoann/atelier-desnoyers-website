# Variables d'environnement (optionnelles pour le développement local)

# Informations GitHub (à remplir dans public/admin/config.yml)
VITE_GITHUB_REPO=https://github.com/Ervoann/atelier-desnoyers-website.git

# URL du site en production
VITE_SITE_URL=https://atelier-desnoyers.com/

# Note : Les secrets FTP sont configurés directement dans GitHub Actions
# Ne jamais commiter les vraies valeurs FTP dans le code !
